# ==============================================================================
# Backend Environment Configuration (Server-Side Secrets & Settings)
# ==============================================================================
# IMPORTANT SECURITY NOTE:
# Variables in this file are strictly SERVER-SIDE only.
# They MUST NEVER be shared with or exposed to the frontend/browser client.
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / Groq LLM Configuration (Placeholders for Future Phase - Not Active Yet)
# Do NOT hardcode this model in application code. Change it here when switching models.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Database Configuration (Placeholder for Future Phase - Not Active Yet)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivoa_complaints
