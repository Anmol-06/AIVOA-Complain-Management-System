# ==============================================================================
# Frontend Environment Configuration (Client-Side Variables)
# ==============================================================================
# IMPORTANT SECURITY NOTE:
# In Vite, variables prefixed with "VITE_" are embedded into the client JavaScript bundle.
# NEVER put private API keys, database passwords, or server secrets here!
# Groq API keys and database credentials MUST live exclusively in backend/.env.
# ==============================================================================

# Backend API base URL for network requests
VITE_API_BASE_URL=http://localhost:8000
